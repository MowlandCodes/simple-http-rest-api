{
  "name": "http-rest-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test",
    "migrate:dev": "drizzle-kit generate",
    "migrate:apply": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  }
}
